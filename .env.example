# 复制本文件为 .env 后填写。路径建议使用正斜杠 /，避免反斜杠被 dotenv 当作转义字符。

# --- NapCat / QQ ---
TOKEN_WEBSOCKET=change-me
WS_BASE_URL=ws://127.0.0.1:3001
TOKEN_SEND=change-me
URL_SEND=http://127.0.0.1:6098/send_private_msg

# --- 路径 ---
# 报表、缓存与合并结果的根目录
REPORT_PATH=C:/Users/your-name/Desktop/报表
# QQ 图片目录，多个目录用英文逗号分隔
LOCAL_IMAGES_DIR=C:/Users/your-name/Documents/Tencent Files/123456/nt_qq/nt_data/Pic/2026-10/Thumb,C:/Users/your-name/Documents/Tencent Files/123456/nt_qq/nt_data/Pic/2026-10/Ori
# 是否自动把路径中的 YYYY-MM 替换为当前月份（每月 1 号使用上个月）
AUTO_MONTH_PATHS=True
# 设施编号表路径；留空时自动查找程序目录下的 编号集合.xlsx
FACILITY_FILE=

# --- 维修通知 ---
REPORT_PEOPLE_QQ=
REPORT_GROUP=
REQUEST_TIMEOUT=10
